{
  "_doc": "Cross-language parity vectors. Each scenario is run through both the Rust matcher (programs/flash-book/tests/parity_test.rs) and the TS simulator (sdk-ts/tests/parity.test.ts) on the same input, and both must produce the same clearing price + clearing volume. If either drifts, both tests fail loudly.",
  "scenarios": [
    {
      "name": "non_crossing_book_no_fills",
      "orders": [
        { "id": 1, "trader_seed": 1, "side": "long",  "order_type": "limit", "size": 1, "limit": 99,  "seq": 0 },
        { "id": 2, "trader_seed": 2, "side": "short", "order_type": "limit", "size": 1, "limit": 101, "seq": 1 }
      ],
      "prior_mark": 100,
      "expected": { "clearing_volume": 0, "fill_count": 0 }
    },
    {
      "name": "single_crossing_pair_fills_at_uniform_price",
      "orders": [
        { "id": 1, "trader_seed": 1, "side": "long",  "order_type": "limit", "size": 1, "limit": 101, "seq": 0 },
        { "id": 2, "trader_seed": 2, "side": "short", "order_type": "limit", "size": 1, "limit": 99,  "seq": 1 }
      ],
      "prior_mark": 100,
      "expected": { "clearing_volume": 1, "fill_count": 1 }
    },
    {
      "name": "tie_break_picks_prior_mark",
      "orders": [
        { "id": 1, "trader_seed": 1, "side": "long",  "order_type": "limit", "size": 1, "limit": 101, "seq": 0 },
        { "id": 2, "trader_seed": 2, "side": "long",  "order_type": "limit", "size": 1, "limit": 100, "seq": 1 },
        { "id": 3, "trader_seed": 3, "side": "short", "order_type": "limit", "size": 1, "limit": 100, "seq": 2 },
        { "id": 4, "trader_seed": 4, "side": "short", "order_type": "limit", "size": 1, "limit": 99,  "seq": 3 }
      ],
      "prior_mark": 100,
      "expected": { "clearing_price": 100, "clearing_volume": 2, "fill_count": 2 }
    },
    {
      "name": "liquidation_priority_fills_first",
      "orders": [
        { "id": 1, "trader_seed": 1, "side": "long",  "order_type": "taker",       "size": 1, "limit": 105, "seq": 0 },
        { "id": 2, "trader_seed": 2, "side": "long",  "order_type": "liquidation", "size": 1, "limit": 105, "seq": 1 },
        { "id": 3, "trader_seed": 3, "side": "short", "order_type": "limit",       "size": 1, "limit": 95,  "seq": 2 }
      ],
      "prior_mark": 100,
      "expected": { "clearing_volume": 1, "fill_count": 1, "first_fill_taker_seed": 2 }
    },
    {
      "name": "fifo_within_priority_class",
      "orders": [
        { "id": 1, "trader_seed": 1, "side": "long",  "order_type": "taker", "size": 1, "limit": 105, "seq": 100 },
        { "id": 2, "trader_seed": 2, "side": "long",  "order_type": "taker", "size": 1, "limit": 105, "seq": 50  },
        { "id": 3, "trader_seed": 3, "side": "short", "order_type": "limit", "size": 1, "limit": 95,  "seq": 1   }
      ],
      "prior_mark": 100,
      "expected": { "clearing_volume": 1, "fill_count": 1, "first_fill_taker_seed": 2 }
    },
    {
      "_doc": "Self-trade prevention. Both implementations compute the Walrasian-max clearing volume (1) but the actual fills are skipped because the same trader is on both sides. clearing_volume reflects theoretical max; fill_count reflects actual after STP.",
      "name": "self_trade_prevention_skips_pair",
      "orders": [
        { "id": 1, "trader_seed": 7, "side": "long",  "order_type": "limit", "size": 1, "limit": 105, "seq": 0 },
        { "id": 2, "trader_seed": 7, "side": "short", "order_type": "limit", "size": 1, "limit": 95,  "seq": 1 }
      ],
      "prior_mark": 100,
      "expected": { "clearing_volume": 1, "fill_count": 0 }
    },
    {
      "_doc": "Walrasian max at indifference. D(99) = 10, S(99) = 4, min = 4. D(100) = 5, S(100) = 8, min = 5. So max-min(D,S) = 5 at p=100.",
      "name": "volume_maximization_at_indifference_price",
      "orders": [
        { "id": 1, "trader_seed": 1, "side": "long",  "order_type": "limit", "size": 5, "limit": 100, "seq": 0 },
        { "id": 2, "trader_seed": 2, "side": "long",  "order_type": "limit", "size": 5, "limit": 99,  "seq": 1 },
        { "id": 3, "trader_seed": 3, "side": "short", "order_type": "limit", "size": 4, "limit": 100, "seq": 2 },
        { "id": 4, "trader_seed": 4, "side": "short", "order_type": "limit", "size": 4, "limit": 99,  "seq": 3 }
      ],
      "prior_mark": 99,
      "expected": { "clearing_price": 100, "clearing_volume": 5 }
    },
    {
      "name": "empty_input_no_fills",
      "orders": [],
      "prior_mark": 100,
      "expected": { "clearing_price": 100, "clearing_volume": 0, "fill_count": 0 }
    }
  ]
}
