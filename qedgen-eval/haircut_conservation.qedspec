// Focused proof: the haircut dust-conservation bound that CBMC/Kani could only
// verify with a representative power-of-two divisor (D = 1<<30). Here the real
// denominator H_DENOM = 1e9 is used directly — testing whether the Lean backend
// closes what bounded model checking could not.
//
//   credit = floor(matured * h / H_DENOM),  given h <= H_DENOM
//   claim:  credit <= matured   (a haircut never overpays the matured PnL)

spec HaircutConservation

const H_DENOM = 1000000000

type State
  | Active of {
      credited : U128,
    }

type Error
  | OutOfRange

ref_impl haircut_credit (matured : U128) (h : U128) : U128 =
  (matured * h) / H_DENOM

handler convert (matured : U128) (h : U128) : State.Active -> State.Active {
  requires h <= H_DENOM else OutOfRange
  modifies [credited]
  effect { credited := haircut_credit(matured, h) }
  ensures state.credited <= matured
}
