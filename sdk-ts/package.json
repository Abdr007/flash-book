{
  "name": "@flash-book/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client for the Flash Book Anchor program. Typed instruction builders, PDA derivation, event decoding.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pdas": "./src/pdas.ts",
    "./client": "./src/client.ts",
    "./events": "./src/events.ts",
    "./errors": "./src/errors.ts",
    "./params": "./src/params.ts",
    "./idl": "./idl.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "typescript": "^5.7.3"
  }
}
