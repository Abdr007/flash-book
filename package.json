{
  "name": "flash-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pool-backed CLOB matched by frequent batch auction on MagicBlock ER. Reference design + simulator for Flash.trade orderbook V3.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./engine": "./src/engine.ts",
    "./matcher": "./src/matcher.ts",
    "./flp-quoter": "./src/flp-quoter.ts",
    "./risk": "./src/risk.ts",
    "./liquidation": "./src/liquidation.ts",
    "./funding": "./src/funding.ts",
    "./vpin": "./src/vpin.ts",
    "./insurance": "./src/insurance.ts",
    "./commit-reveal": "./src/commit-reveal.ts"
  },
  "workspaces": ["sdk-ts", "bot"],
  "scripts": {
    "typecheck": "tsc --noEmit && bun --cwd sdk-ts run typecheck && bun --cwd bot run typecheck",
    "test": "bun test && bun --cwd bot test",
    "example": "bun run examples/synthetic-flow.ts",
    "example:flash": "bun run examples/replay-flash.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3"
  }
}
